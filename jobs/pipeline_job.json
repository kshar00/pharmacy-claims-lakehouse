{
  "name": "pharmacy_claims_lakehouse_pipeline",
  "description": "Pharmacy Claims Lakehouse: setup -> synthetic data -> bronze -> silver -> data quality -> gold. Serverless only. Gold is skipped if any ERROR-level data quality check fails.",
  "tags": {
    "project": "pharmacy_claims_lakehouse",
    "data": "synthetic"
  },
  "max_concurrent_runs": 1,
  "timeout_seconds": 7200,
  "queue": {
    "enabled": true
  },
  "parameters": [
    { "name": "catalog", "default": "portfolio" },
    { "name": "run_id", "default": "{{job.run_id}}" },
    { "name": "reset", "default": "false" }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  },
  "tasks": [
    {
      "task_key": "setup_catalog",
      "description": "Create the catalog, schemas and volumes (idempotent).",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/YOUR_USER_NAME/pharmacy_claims_lakehouse/notebooks/00_setup_catalog",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 600,
      "max_retries": 0
    },
    {
      "task_key": "generate_synthetic_data",
      "description": "Write the synthetic CSV extracts and manifest to the landing volume. Seeded, so every run writes identical files.",
      "depends_on": [{ "task_key": "setup_catalog" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/YOUR_USER_NAME/pharmacy_claims_lakehouse/notebooks/01_generate_synthetic_data",
        "source": "WORKSPACE",
        "base_parameters": { "write_mode": "all", "random_seed": "42" }
      },
      "timeout_seconds": 1200,
      "max_retries": 0
    },
    {
      "task_key": "bronze_ingest",
      "description": "Auto Loader (availableNow) from landing into bronze; reconcile to the manifest.",
      "depends_on": [{ "task_key": "generate_synthetic_data" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/YOUR_USER_NAME/pharmacy_claims_lakehouse/notebooks/02_bronze_ingest",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 1800,
      "max_retries": 0
    },
    {
      "task_key": "silver_claims",
      "description": "Normalise NDCs, net reversals, dedupe, flag eligibility; write claims_final and claims_rejected.",
      "depends_on": [{ "task_key": "bronze_ingest" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/YOUR_USER_NAME/pharmacy_claims_lakehouse/notebooks/03_silver_claims",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 1800,
      "max_retries": 0
    },
    {
      "task_key": "silver_dq",
      "description": "Run 34 data quality checks and append them to silver.dq_results. Fails the run on any ERROR-level failure.",
      "depends_on": [{ "task_key": "silver_claims" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/YOUR_USER_NAME/pharmacy_claims_lakehouse/notebooks/04_silver_dq",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 1200,
      "max_retries": 0
    },
    {
      "task_key": "gold_marts",
      "description": "Build gold marts, reconcile to silver, MERGE the pipeline audit for this run.",
      "depends_on": [{ "task_key": "silver_dq" }],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/YOUR_USER_NAME/pharmacy_claims_lakehouse/notebooks/05_gold_marts",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 1200,
      "max_retries": 0
    }
  ]
}
